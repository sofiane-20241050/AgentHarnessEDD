# AgentHarnessEDD 环境变量模板 —— 复制为 .env 后填写
# 分层优先级：默认值 < models.yaml < .env/环境变量 < CLI 显式传入

# 被测模型（必填）
AHEDD_AGENT_MODEL=<model-id>
AHEDD_AGENT_BASE_URL=http://localhost:8000/v1
AHEDD_AGENT_API_KEY=<key-or-EMPTY-for-local-vllm>

# 用户模拟器（多轮交互数据集需要）
AHEDD_USER_SIMULATOR_MODEL=<model-id>
AHEDD_USER_SIMULATOR_BASE_URL=<base-url>
AHEDD_USER_SIMULATOR_API_KEY=<key>

# 判分器（rubric 判分需要）
AHEDD_JUDGE_MODEL=<model-id>
AHEDD_JUDGE_BASE_URL=<base-url>
AHEDD_JUDGE_API_KEY=<key>

# Claude Code CLI 车道（可选：RPC 子进程模式）
AHEDD_CC_SSH=<user@host 或留空走本地>
AHEDD_CC_DIR=<claude 工作目录，.claude/settings.local.json 生效范围>
AHEDD_CC_NODE_BIN=<claude 所在 nvm bin 目录>
